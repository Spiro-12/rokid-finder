<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!--
      Live camera preview, drawn BEHIND the HUD. Hidden by default so normal
      wear stays a clean optical see-through. Toggle with volume-up (see
      MainActivity.onKeyDown) when recording.
    -->
    <ImageView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0.5"
        android:contentDescription="camera preview"
        android:visibility="gone" />

    <!-- Watching presence: the entire idle UI. -->
    <View
        android:id="@+id/presenceDot"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="72dp"
        android:background="@drawable/presence_dot" />

    <!-- Reusable whisper line for save / voice / status moments. Hidden by default. -->
    <TextView
        android:id="@+id/whisper"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="108dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="4dp"
        android:text=""
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:fontFamily="sans-serif"
        android:alpha="0"
        android:visibility="invisible" />


</FrameLayout>
